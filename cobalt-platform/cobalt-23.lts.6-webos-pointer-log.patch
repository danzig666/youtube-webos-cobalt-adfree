+// Opt-in Magic Remote diagnostics for the user to upload: one bounded,
+// append-only text file in /tmp that is cleared when it grows past 1 MiB.
+bool H5vccSystem::AppendYtafPointerLog(const std::string& text) const {
+#if defined(STARBOARD_WEBOS)
+  static const int64_t kMaximumBytes = 1024 * 1024;
+  if (text.empty()) return true;
+  std::string line = text.substr(0, 4096);
+  if (line.back() != '\n') line += '\n';
+  bool created = false;
+  SbFileError error = kSbFileOk;
+  SbFile file = SbFileOpen("/tmp/ytaf-pointer.log", kSbFileOpenAlways | kSbFileWrite,
+                           &created, &error);
+  if (!SbFileIsValid(file)) return false;
+  int64_t end = SbFileSeek(file, kSbFileFromEnd, 0);
+  if (end < 0 || end + static_cast<int64_t>(line.size()) > kMaximumBytes) {
+    SbFileTruncate(file, 0);
+    SbFileSeek(file, kSbFileFromBegin, 0);
+  }
+  const int written = SbFileWrite(file, line.data(), static_cast<int>(line.size()));
+  SbFileClose(file);
+  return written == static_cast<int>(line.size());
+#else
+  (void)text;
+  return false;
+#endif
+}
