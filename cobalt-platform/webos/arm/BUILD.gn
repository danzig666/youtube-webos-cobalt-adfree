# Keep vendor capture headers scoped to these files. Existing Cobalt sources
# retain their compiler flags and header resolution, including cached builds.
source_set("voice_capture") {
  check_includes = false
  sources = [ "lg_native_bus.cc", "lg_native_bus.h", "lg_bus_dispatch.h",
              "lg_voice_capture.cc", "lg_voice_capture.h", "lg_voice_api.cc",
              "lg_voice_api.h", "lg_voice_api.inc", "microphone.cc",
              "webos_microphone_report.h" ]
  voice_sysroot = getenv("WEBOS_SDK_ROOT") + "/arm-webos-linux-gnueabi/sysroot"
  include_dirs = [ "$voice_sysroot/usr/include/glib-2.0",
                   "$voice_sysroot/usr/lib/glib-2.0/include" ]
  configs += [ "//starboard/build/config:starboard_implementation" ]
}

# Keep FFmpeg 5 headers private to the firmware decoder and diagnostic translation units.
# Existing Cobalt FFmpeg adapters retain their own ABI-specific headers.
source_set("firmware_ffmpeg_probe") {
  check_includes = false
  sources = [ "webos_ffmpeg_probe.cc", "webos_ffmpeg_probe.h",
              "webos_firmware_aac.cc", "webos_firmware_aac.h" ]
  include_dirs = [ "ffmpeg5" ]
  configs += [ "//starboard/build/config:starboard_implementation" ]
}
